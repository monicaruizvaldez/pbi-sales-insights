annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation __TEdtr = 1

ref table @Measures
ref table aux_products
ref table aux_topN
ref table dim_customers
ref table dim_products
ref table dim_calendar
ref table 'Parameter Sales'
ref table fact_sales
ref table dim_employees
