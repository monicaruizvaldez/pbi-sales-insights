table @Measures
	lineageTag: 085124ec-feee-419f-8472-37382c34e58d

	measure 'Has Data (Calendar-Sales)' =
			
			
			IF(
			    COUNTROWS(fact_sales) > 0,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Aux\Has Data
		lineageTag: 0de67326-7998-422c-8e30-25ca8b4f6353

	measure '($) Sales Amount' =
			
			
			SUM(fact_sales[TotalAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Sales\Amount
		lineageTag: 45b3b7bc-54ba-457f-8546-21fdc223b032

	measure '_N Value' =
			
			3
		formatString: #,0
		displayFolder: TopN
		lineageTag: 30509306-682c-424c-9b3a-5977e05c1e73

	measure 'Top N Sales' = ```
			
			
			VAR _N = 'TopN Selected'[TopN Selected Value]
			VAR _CurrentProd = SELECTEDVALUE('Products Table'[ProductName])
			VAR _TopN = 
			    TOPN(
			        _N,
			        ALLSELECTED('Products Table'),
			        [($) Sales Amount]
			    )
			
			VAR _TopSales =
			    CALCULATE(
			        [($) Sales Amount],
			        KEEPFILTERS(_TopN)
			    )
			
			VAR _OtherSales =
			CALCULATE(
			    [($) Sales Amount],
			    ALLSELECTED('Products Table'[ProductName])
			) -
			CALCULATE(
			    [($) Sales Amount],
			    _TopN
			)
			       
			RETURN
			IF(
			    _CurrentProd <> "Others",
			    _TopSales,
			    _OtherSales
			)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: TopN
		lineageTag: 59f75a37-0db9-433e-b30b-19291a911e7f

	measure Rank =
			
			
			IF(
			    [Top N Sales] <> BLANK(),
			    RANKX(
			        TOPN(
			            'TopN Selected'[TopN Selected Value],
			            ALLSELECTED('Products Table'),
			            [($) Sales Amount]
			        ),
			    [($) Sales Amount],
			    ,
			    DESC,
			    Dense
			    )
			)
		formatString: #,0
		displayFolder: TopN
		lineageTag: 95e60702-391c-4406-be57-48bd67accc18

	measure '($) Cumulative Sales Amount PY' =
			
			
			CALCULATE(
			    [($) Sales Amount],
			    DATESYTD(SAMEPERIODLASTYEAR('dim_calendar'[Date]))
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Sales\Amount
		lineageTag: c8fed628-7b27-410d-96d9-91c4923d9475

	measure '($) Cumulative Sales Amount' =
			
			
			CALCULATE(
			    [($) Sales Amount],
			    DATESYTD('dim_calendar'[Date]),
			    'dim_calendar'[Date] <= MAX(fact_sales[Date])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Sales\Amount
		lineageTag: c7a1ff65-7286-4525-bd12-a1486d70ac7e

	measure 'Color: Transparent' =
			
			
			"#FFFFFF00"
		displayFolder: Aux\Color
		lineageTag: 9975583e-7500-4a06-809c-d8f90b582db1

	measure 'Card: Top N Products' =
			
			
			"Top " & 'TopN Selected'[TopN Selected Value] & " Products"
		displayFolder: Aux\Cards/Titles
		lineageTag: 84133b36-84b1-4373-a256-2b2ffeafc8d5

	measure 'Card: Total Selected Year' =
			
			
			"Total " & SELECTEDVALUE('dim_calendar'[Year])
		displayFolder: Aux\Cards/Titles
		lineageTag: 776b3943-cb18-4108-8068-1cf23b1e8407

	measure 'Card: Total Previous Year' =
			
			
			"Total " & SELECTEDVALUE('dim_calendar'[Year])-1
		displayFolder: Aux\Cards/Titles
		lineageTag: 39b4972c-f707-483f-9b60-d746716cf35f

	measure 'Graph Title: Cumulative Sales' =
			
			
			"Cumulative Sales
			
			 "
		displayFolder: Aux\Cards/Titles
		lineageTag: 3b9ee586-2703-49e9-9c01-35667d9b039b

	measure '(#) Orders' =
			
			
			DISTINCTCOUNT(fact_sales[SaleID])
		formatString: #,0
		displayFolder: Sales\Count
		lineageTag: 14dae302-6fc6-42bb-bc64-1a2e7eff29f4

	measure '(#) Orders Cumulative' =
			
			
			CALCULATE(
			    [(#) Orders],
			    'dim_calendar'[Date] < MAX('fact_sales'[Date])
			)
		formatString: #,0
		displayFolder: Sales\Count
		lineageTag: af3ac5cd-1326-4465-99b0-7cbeb2492c4c

	measure '(#) Orders Cumulative PY' =
			
			
			VAR _PrevYear = SELECTEDVALUE('dim_calendar'[Year]) - 1
			
			RETURN
			CALCULATE(
			    [(#) Orders Cumulative],
			    YEAR(fact_sales[Date]) = _PrevYear,
			    REMOVEFILTERS('dim_calendar'[Year])
			)
		formatString: 0
		displayFolder: Sales\Count
		lineageTag: 554b0fc9-2549-47b1-88c5-e9cb92490419

	measure 'Count Sales Cumulative' =
			
			
			CALCULATE(
			    [(#) Orders Cumulative],
			    YEAR(fact_sales[Date]) = SELECTEDVALUE('dim_calendar'[Year])
			)
		formatString: 0
		displayFolder: Sales\Count
		lineageTag: 8c4857bd-dc98-4e3c-a8fa-aedf4227a749

	measure 'Card: Selected Category' =
			
			
			SELECTEDVALUE('dim_products'[Category])
		displayFolder: Aux\Cards/Titles
		lineageTag: 865816e7-7b82-4f77-a343-f6e152ca53e7

	measure 'Card: Selected Category (Title)' =
			
			
			"Category"
		displayFolder: Aux\Cards/Titles
		lineageTag: edacc21a-a1b8-4430-9a4e-07b4d5b58028

	measure 'Param. Total Sales/Count Sales (Previous Year)' = ```
			
			
			VAR _PrevYear = SELECTEDVALUE('dim_calendar'[Year]) - 1
			
			RETURN
			CALCULATE(
			    IF(
			        SELECTEDVALUE('Parameter Sales (Count/Amount Sold)'[Parameter Sales (Count/Amount Sold) Order]) = 0, 
			        [($) Sales Amount],
			        [(#) Orders]
			    ),
			    YEAR(fact_sales[Date]) = _PrevYear,
			    REMOVEFILTERS('dim_calendar'[Year]),
			    REMOVEFILTERS(fact_sales[Date])
			)
			```
		formatString: #,0
		displayFolder: Sales\Parameter
		lineageTag: 08236dbc-8cba-4c6c-84e4-3e5d440fe0d7

	measure 'Param. Total Sales/Count Sales (Selected Year)' = ```
			
			
			VAR _Year = SELECTEDVALUE('dim_calendar'[Year])
			
			RETURN
			CALCULATE(
			    IF(
			        SELECTEDVALUE('Parameter Sales (Count/Amount Sold)'[Parameter Sales (Count/Amount Sold) Order]) = 0, 
			        [($) Sales Amount],
			        [(#) Orders]
			    ),
			    YEAR(fact_sales[Date]) = _Year
			)
			```
		formatString: #,0
		displayFolder: Sales\Parameter
		lineageTag: 058588dd-a323-42a7-a322-9360846b85ab

	measure 'Detail Other (%)' = ```
			
			
			VAR _N = 'TopN Selected'[TopN Selected Value]
			VAR _TopN = 
			    TOPN(
			        _N,
			        ALLSELECTED('Products Table'),
			        [($) Sales Amount]
			    )
			
			VAR _OtherSales =
			CALCULATE(
			    [($) Sales Amount],
			    ALLSELECTED('Products Table'[ProductName])
			) -
			CALCULATE(
			    [($) Sales Amount],
			    _TopN
			)
			
			RETURN
			IF(
			    SELECTEDVALUE('Products Table'[ProductName]) = "Others",
			    DIVIDE(
			        _OtherSales,
			        CALCULATE(
			            [($) Sales Amount],
			            ALLSELECTED('Products Table'[ProductName])
			        )
			    ),
			    BLANK()
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: TopN
		lineageTag: 93f0600a-977c-49e6-887a-5dcaa40f821a

	measure 'Graph Max: Top N Products' = ```
			
			
			VAR _N = 'TopN Selected'[TopN Selected Value]
			VAR _TopN = 
			    TOPN(
			        _N,
			        ALLSELECTED('Products Table'),
			        [($) Sales Amount]
			    )
			
			VAR _OtherSales =
			CALCULATE(
			    [($) Sales Amount],
			    ALLSELECTED('Products Table'[ProductName])
			) -
			CALCULATE(
			    [($) Sales Amount],
			    _TopN
			)
			
			RETURN
			_OtherSales * 1.2
			```
		displayFolder: Aux\Settings
		lineageTag: 4d53ecf0-8ef6-498b-8dc1-133b8ac19294

		annotation PBI_FormatHint = {"isGeneralNumber":true}

