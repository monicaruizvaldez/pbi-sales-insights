table 'Products Table'
	isHidden
	lineageTag: 63bd2b89-8cbe-4c4b-bfc1-5d96d6b75df5

	column Color =
			
			
			IF(
			    'Products Table'[ProductName] <> "Others",
			    "#0F63F4",
			    "#B3B3B3"
			)
		isHidden
		lineageTag: 6bdbd43c-4e4e-4562-a5bf-f0fb1e870edf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ProductName
		lineageTag: d31f27fc-88b5-4f0d-965a-a10917f3c36e
		summarizeBy: none
		isNameInferred
		sourceColumn: dim_products[ProductName]

		annotation SummarizationSetBy = Automatic

	partition 'Products Table' = calculated
		mode: import
		source =
				
				
				UNION(
				    DISTINCT('dim_products'[ProductName]),
				    DATATABLE("ProductName", STRING, {{"Others"}})
				)

	annotation PBI_Id = 569e1377ba214f2a8684be83c0a2ca03

